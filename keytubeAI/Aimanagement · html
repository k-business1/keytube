<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>KEYTUBE AI Management</title>
<link rel="icon" href="../imagelib/logo.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&family=Bebas+Neue&display=swap" rel="stylesheet">
<link rel="stylesheet" href="aimanagement.css">
</head>
<body>
<div id="pbar"></div>
<div id="toast"></div>

<!-- TOP BAR -->
<div class="ai-bar">
  <div class="ai-bar-logo">
    <img src="../imagelib/ailogo.png" alt="AI" onerror="this.src='../imagelib/logo.png'">
    <span class="ai-bar-title">🤖 KEYTUBE AI Management</span>
  </div>
  <a class="ai-bar-back" href="admin.html">← Admin Panel</a>
</div>

<div class="ai-body">

  <!-- STATS ROW -->
  <div class="ai-stats">
    <div class="ai-stat"><div class="ai-stat-n" id="statTerms">—</div><div class="ai-stat-l">Key Terms</div></div>
    <div class="ai-stat"><div class="ai-stat-n" id="statActive">—</div><div class="ai-stat-l">Active</div></div>
    <div class="ai-stat"><div class="ai-stat-n" id="statCats">—</div><div class="ai-stat-l">Categories</div></div>
    <div class="ai-stat"><div class="ai-stat-n" id="statFetch">—</div><div class="ai-stat-l">With Data Fetch</div></div>
  </div>

  <!-- LEFT COLUMN: Key Terms List -->
  <div>

    <!-- FILTERS -->
    <div class="ai-card" style="padding:13px 16px;margin-bottom:14px">
      <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px">
        <div class="cat-pills" id="catFilter">
          <button class="cat-pill active" onclick="filterCat('all',this)">All</button>
          <button class="cat-pill" onclick="filterCat('greeting',this)">👋 Greeting</button>
          <button class="cat-pill" onclick="filterCat('movies',this)">🎬 Movies</button>
          <button class="cat-pill" onclick="filterCat('channels',this)">📺 Channels</button>
          <button class="cat-pill" onclick="filterCat('help',this)">❓ Help</button>
          <button class="cat-pill" onclick="filterCat('earnings',this)">💰 Earnings</button>
          <button class="cat-pill" onclick="filterCat('support',this)">🛠 Support</button>
          <button class="cat-pill" onclick="filterCat('general',this)">🌐 General</button>
        </div>
        <div style="display:flex;gap:7px">
          <button class="ai-btn ai-btn-ai" onclick="openAddModal()">+ Add Key Term</button>
          <button class="ai-btn ai-btn-out" onclick="loadTerms()">↺</button>
        </div>
      </div>
    </div>

    <!-- TERMS LIST -->
    <div id="termsList"></div>
    <div class="empty hidden" id="termsEmpty">
      <div class="ei">🤖</div>
      <p>No key terms yet.</p>
      <button class="ai-btn ai-btn-ai" style="margin-top:12px" onclick="loadDefaults()">Load Default Key Terms</button>
    </div>

  </div>

  <!-- RIGHT COLUMN: Add Form + Test + Syntax -->
  <div>

    <!-- SYNTAX GUIDE -->
    <div class="ai-card">
      <div class="ai-card-title">🔧 Fetch Syntax</div>
      <p style="font-size:.77rem;color:var(--t2);margin-bottom:11px;line-height:1.5">
        Use these placeholders in your <strong>Response</strong> field to inject live data from the database:
      </p>
      <div class="syntax-grid" id="syntaxGrid">
        <div class="syntax-item" onclick="insertSyntax('{total_movies}')">
          <span class="syntax-code">{total_movies}</span>
          <span class="syntax-desc">Total number of movies</span>
        </div>
        <div class="syntax-item" onclick="insertSyntax('{total_users}')">
          <span class="syntax-code">{total_users}</span>
          <span class="syntax-desc">Total registered users</span>
        </div>
        <div class="syntax-item" onclick="insertSyntax('{most_viewed_movie}')">
          <span class="syntax-code">{most_viewed_movie}</span>
          <span class="syntax-desc">Name of most viewed movie</span>
        </div>
        <div class="syntax-item" onclick="insertSyntax('{recent_movie}')">
          <span class="syntax-code">{recent_movie}</span>
          <span class="syntax-desc">Most recently added movie</span>
        </div>
        <div class="syntax-item" onclick="insertSyntax('{top_channel}')">
          <span class="syntax-code">{top_channel}</span>
          <span class="syntax-desc">Most followed channel name</span>
        </div>
        <div class="syntax-item" onclick="insertSyntax('{top_channel_followers}')">
          <span class="syntax-code">{top_channel_followers}</span>
          <span class="syntax-desc">Top channel follower count</span>
        </div>
        <div class="syntax-item" onclick="insertSyntax('{monetize_threshold}')">
          <span class="syntax-code">{monetize_threshold}</span>
          <span class="syntax-desc">Followers needed to monetize</span>
        </div>
      </div>
      <div class="privacy-note">
        🔒 <span><strong>Privacy rule:</strong> Never use emails, passwords or personal IDs. The AI automatically blocks any response containing private user data.</span>
      </div>
      <div style="margin-top:11px">
        <p style="font-size:.74rem;color:var(--t2);margin-bottom:5px"><strong>DataFetch field:</strong> list the placeholders you use (comma-separated):</p>
        <code style="font-size:.73rem;background:var(--bg2);padding:4px 8px;border-radius:3px;display:block">total_movies,most_viewed_movie</code>
      </div>
    </div>

    <!-- TEST AI -->
    <div class="ai-card">
      <div class="ai-card-title">🧪 Test AI Response</div>
      <div class="test-chat" id="testChat">
        <div class="test-msg">
          <div class="test-av"><img src="../imagelib/ailogo.png" onerror="this.src='../imagelib/logo.png'" alt="AI"></div>
          <div class="test-bubble ai-b">👋 Hello! Type something to test the AI response matching.</div>
        </div>
      </div>
      <div class="test-input-row">
        <input class="test-input" id="testInput" type="text" placeholder="Type a test question…"
               onkeydown="if(event.key==='Enter')testAI()">
        <button class="test-send" onclick="testAI()">Send</button>
      </div>
    </div>

    <!-- LOAD DEFAULTS -->
    <div class="ai-card" style="text-align:center;padding:16px">
      <p style="font-size:.8rem;color:var(--t2);margin-bottom:11px">Load all default KEYTUBE AI responses</p>
      <button class="ai-btn ai-btn-green" id="defaultBtn" onclick="loadDefaults()">⚡ Load Default Key Terms</button>
    </div>

  </div>
</div>

<!-- ADD / EDIT MODAL -->
<div class="modal-bg" id="editModal">
  <div class="modal-box">
    <div class="modal-hd">
      <h3 id="modalTitle">➕ Add Key Term</h3>
      <button class="modal-close" onclick="closeModal()">✕</button>
    </div>

    <div class="fg">
      <label>Keywords * <span style="font-weight:400;text-transform:none;color:var(--t3)">(comma-separated — e.g. hello, hi, hey)</span></label>
      <input class="fi" id="fKeywords" type="text" placeholder="hello, hi, hey, good morning">
    </div>

    <div class="fg">
      <label>Response * <span style="font-weight:400;text-transform:none;color:var(--t3)">(use {placeholders} for live data)</span></label>
      <textarea class="fi fi-ta" id="fResponse" placeholder="Hello! Welcome to KEYTUBE! We have {total_movies} movies available…" rows="6"></textarea>
    </div>

    <div class="fg">
      <label>DataFetch <span style="font-weight:400;text-transform:none;color:var(--t3)">(list placeholders used, comma-separated)</span></label>
      <input class="fi" id="fDataFetch" type="text" placeholder="total_movies, most_viewed_movie">
      <div style="font-size:.71rem;color:var(--t2);margin-top:3px">Leave blank if response has no {placeholders}</div>
    </div>

    <div class="fg">
      <label>Category</label>
      <select class="fi fi-sel" id="fCategory">
        <option value="general">🌐 General</option>
        <option value="greeting">👋 Greeting</option>
        <option value="movies">🎬 Movies</option>
        <option value="channels">📺 Channels</option>
        <option value="help">❓ Help</option>
        <option value="earnings">💰 Earnings</option>
        <option value="support">🛠 Support</option>
      </select>
    </div>

    <div class="fg" style="display:flex;align-items:center;gap:10px">
      <label style="margin-bottom:0">Active</label>
      <label class="toggle-switch">
        <input type="checkbox" id="fActive" checked>
        <span class="ts-slider"></span>
      </label>
    </div>

    <div style="background:rgba(255,0,0,.04);border:1px solid rgba(255,0,0,.12);border-radius:var(--r2px);padding:9px 11px;font-size:.74rem;color:var(--red);margin-bottom:4px">
      🔒 Do NOT include emails, passwords, user IDs or any private information in responses.
    </div>

    <div class="btn-row">
      <button class="ai-btn ai-btn-ai" id="saveBtn" onclick="saveTerm()">💾 Save</button>
      <button class="ai-btn ai-btn-out" onclick="closeModal()">Cancel</button>
    </div>
  </div>
</div>

<script src="aimanagement.js"></script>
</body>
</html>
