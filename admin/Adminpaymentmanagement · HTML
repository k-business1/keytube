<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Payment Management · KEYTUBE Admin</title>
<link rel="icon" href="../imagelib/logo.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&family=Bebas+Neue&display=swap" rel="stylesheet">
<link rel="stylesheet" href="adminpaymentmanagement.css">
</head>
<body>

<div id="pbar"></div>
<div id="toast"></div>

<!-- TOP BAR -->
<div class="pm-bar">
  <div class="pm-bar-logo">⚙ KEYTUBE</div>
  <div class="pm-bar-title">💰 Payment & Earnings Management</div>
  <a class="pm-bar-back" href="admin.html">← Back to Admin</a>
</div>

<div class="pm-body">

  <!-- OVERVIEW STATS -->
  <div class="pm-stats" id="overviewStats">
    <div class="pm-stat"><div class="pm-stat-icon">💰</div><div class="pm-stat-n green" id="statPaid">—</div><div class="pm-stat-l">Total Paid Out</div></div>
    <div class="pm-stat"><div class="pm-stat-icon">⏳</div><div class="pm-stat-n gold" id="statPending">—</div><div class="pm-stat-l">Pending</div></div>
    <div class="pm-stat"><div class="pm-stat-icon">💸</div><div class="pm-stat-n blue" id="statWithdrawn">—</div><div class="pm-stat-l">Withdrawn</div></div>
    <div class="pm-stat"><div class="pm-stat-icon">📺</div><div class="pm-stat-n" id="statMono">—</div><div class="pm-stat-l">Monetized Channels</div></div>
    <div class="pm-stat"><div class="pm-stat-icon">👁</div><div class="pm-stat-n" id="statViewRev">—</div><div class="pm-stat-l">From Views</div></div>
    <div class="pm-stat"><div class="pm-stat-icon">❤️</div><div class="pm-stat-n" id="statLikeRev">—</div><div class="pm-stat-l">From Likes</div></div>
    <div class="pm-stat"><div class="pm-stat-icon">💬</div><div class="pm-stat-n" id="statCmtRev">—</div><div class="pm-stat-l">From Comments</div></div>
    <div class="pm-stat"><div class="pm-stat-icon">👥</div><div class="pm-stat-n" id="statFolRev">—</div><div class="pm-stat-l">From Followers</div></div>
  </div>

  <!-- MONETIZATION THRESHOLD -->
  <div class="pm-card">
    <div class="pm-card-title">🔒 Monetization Threshold</div>
    <div class="threshold-row">
      <div class="threshold-icon">👥</div>
      <div class="threshold-info">
        <h4>Minimum Followers to Unlock Earnings</h4>
        <p>A channel must reach this follower count before they can earn money. Currently monetized channels keep earning even if they drop below.</p>
      </div>
      <input type="number" class="threshold-input" id="thresholdInput" value="1000" min="1">
    </div>
    <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap">
      <div style="flex:1">
        <label style="font-size:.78rem;font-weight:600;color:var(--t2)">Minimum Payout Amount ($)</label>
        <input type="number" id="minPayoutInput" value="5.00" min="1" step="0.5"
               style="width:130px;margin-left:10px;border:1.5px solid var(--brd);border-radius:var(--r2px);padding:6px 10px;font-size:.85rem;outline:none">
      </div>
      <div>
        <label style="font-size:.78rem;font-weight:600;color:var(--t2)">Currency</label>
        <select id="currencyInput" style="margin-left:8px;border:1.5px solid var(--brd);border-radius:var(--r2px);padding:6px 10px;font-size:.85rem;outline:none;background:var(--w)">
          <option value="USD">USD $</option>
          <option value="EUR">EUR €</option>
          <option value="RWF">RWF Fr</option>
          <option value="NGN">NGN ₦</option>
          <option value="KES">KES KSh</option>
          <option value="GHS">GHS ₵</option>
        </select>
      </div>
    </div>
    <div class="btn-row">
      <button class="pm-btn pm-btn-red" onclick="saveRates()">💾 Save Settings</button>
      <button class="pm-btn pm-btn-out" onclick="loadRates()">↺ Reset</button>
    </div>
  </div>

  <!-- EARNING RATES -->
  <div class="pm-card">
    <div class="pm-card-title">📊 Earning Rates <span>— amount paid per unit of engagement</span></div>
    <div class="rates-grid">

      <div class="rate-row">
        <label><span class="rate-icon">👁</span> Per View</label>
        <div class="rate-desc">Paid every time someone watches a video on the creator's channel.</div>
        <div class="rate-input-wrap">
          <span class="rate-prefix">$</span>
          <input type="number" class="rate-input" id="rateView" value="0.001" min="0" step="0.0001">
        </div>
        <div class="rate-preview" id="previewView">1,000 views = $1.00</div>
      </div>

      <div class="rate-row">
        <label><span class="rate-icon">❤️</span> Per Like</label>
        <div class="rate-desc">Paid when a viewer likes any video on the creator's channel.</div>
        <div class="rate-input-wrap">
          <span class="rate-prefix">$</span>
          <input type="number" class="rate-input" id="rateLike" value="0.005" min="0" step="0.001">
        </div>
        <div class="rate-preview" id="previewLike">1,000 likes = $5.00</div>
      </div>

      <div class="rate-row">
        <label><span class="rate-icon">💬</span> Per Comment</label>
        <div class="rate-desc">Paid when viewers comment on the creator's videos.</div>
        <div class="rate-input-wrap">
          <span class="rate-prefix">$</span>
          <input type="number" class="rate-input" id="rateComment" value="0.010" min="0" step="0.001">
        </div>
        <div class="rate-preview" id="previewComment">1,000 comments = $10.00</div>
      </div>

      <div class="rate-row">
        <label><span class="rate-icon">👥</span> Per New Follower</label>
        <div class="rate-desc">Paid for each new follower gained after crossing the threshold.</div>
        <div class="rate-input-wrap">
          <span class="rate-prefix">$</span>
          <input type="number" class="rate-input" id="rateFollower" value="0.020" min="0" step="0.001">
        </div>
        <div class="rate-preview" id="previewFollower">1,000 new followers = $20.00</div>
      </div>

    </div>
    <div class="btn-row">
      <button class="pm-btn pm-btn-red" onclick="saveRates()">💾 Save All Rates</button>
      <button class="pm-btn pm-btn-out" onclick="loadRates()">↺ Reset to Saved</button>
    </div>
  </div>

  <!-- PROCESS EARNINGS -->
  <div class="pm-card">
    <div class="pm-card-title">⚡ Process Earnings</div>
    <p style="font-size:.83rem;color:var(--t2);margin-bottom:14px;line-height:1.6">
      Calculate and credit earnings for all monetized channels based on their new activity since the last calculation.
      Only channels with <strong id="threshLabel">1,000+</strong> followers will be processed.
    </p>
    <div class="btn-row">
      <button class="pm-btn pm-btn-green" id="processAllBtn" onclick="processAll()">⚡ Process All Monetized Channels</button>
      <button class="pm-btn pm-btn-out" onclick="loadOverview()">🔄 Refresh Stats</button>
    </div>
    <div class="process-result" id="processResult">
      <div class="pr-row"><span>Channels Processed</span><span id="prChannels">—</span></div>
      <div class="pr-row"><span>Total Earnings Credited</span><span id="prTotal" style="color:var(--green)">—</span></div>
      <div class="pr-row"><span>Status</span><span id="prStatus">—</span></div>
    </div>
  </div>

  <!-- MONETIZED CHANNELS -->
  <div class="pm-card">
    <div class="pm-card-title">📺 All Channels <span id="channelSubTitle"></span></div>
    <div style="margin-bottom:12px;display:flex;gap:8px;flex-wrap:wrap">
      <button class="pm-btn pm-btn-out" style="font-size:.75rem;padding:5px 12px" onclick="filterChannels('all',this)">All</button>
      <button class="pm-btn pm-btn-out" style="font-size:.75rem;padding:5px 12px" onclick="filterChannels('monetized',this)">✅ Monetized</button>
      <button class="pm-btn pm-btn-out" style="font-size:.75rem;padding:5px 12px" onclick="filterChannels('pending',this)">🔒 Not Yet</button>
    </div>
    <div class="pm-table-wrap">
      <table class="pm-table">
        <thead>
          <tr>
            <th>Channel</th>
            <th>Followers</th>
            <th>Status</th>
            <th>Total Earned</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody id="channelsTable"></tbody>
      </table>
    </div>
    <div id="channelsEmpty" style="display:none;text-align:center;padding:30px;color:var(--t2);font-size:.83rem">
      No channels found.
    </div>
  </div>

  <!-- EARNINGS LOG -->
  <div class="pm-card">
    <div class="pm-card-title">📋 Recent Earnings Log <span id="logCount"></span></div>
    <div id="earningsLog"></div>
    <div id="earningsLogEmpty" style="display:none;text-align:center;padding:24px;color:var(--t2);font-size:.83rem">
      No earnings recorded yet.
    </div>
  </div>

</div>

<script src="adminpaymentmanagement.js"></script>
</body>
</html>
