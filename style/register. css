.reset-steps{display:flex;align-items:center;justify-content:center;gap:8px;margin-bottom:20px;}.rst{display:flex;align-items:center;gap:6px;opacity:.5;}.rst.active{opacity:1;}.rst-num{width:24px;height:24px;border-radius:50%;background:#e9eef2;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;color:#159bc4;box-shadow:4px 4px 8px rgba(0,0,0,.12),-4px -4px 8px rgba(255,255,255,.98);}.rst-lbl{font-size:11px;font-weight:700;color:#555a60;text-transform:uppercase;}.rst-line{width:20px;height:2px;background:#cbd5d8;}.otp-wrap{display:flex;justify-content:center;align-items:center;gap:8px;margin:20px 0;}.otp-input{width:42px;height:50px;border:0;outline:0;border-radius:12px;background:#e9eef2;text-align:center;font-size:20px;font-weight:700;color:#292e32;box-shadow:inset 4px 4px 8px rgba(0,0,0,.15),inset -4px -4px 8px rgba(255,255,255,.97);}.otp-dash{font-weight:700;color:#99a0a6;margin:0 2px;}.otp-timer-row{text-align:center;font-size:13px;color:#777e84;margin-bottom:14px;}.otp-timer{font-weight:700;color:#159bc4;}.reg-av-upload{position:relative;width:96px;height:96px;border-radius:50%;background:#e9eef2;display:flex;align-items:center;justify-content:center;cursor:pointer;box-shadow:8px 8px 16px rgba(0,0,0,.14),-8px -8px 16px rgba(255,255,255,.98);overflow:hidden;}.reg-av-edit{position:absolute;bottom:0;right:0;background:#159bc4;color:#fff;width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:12px;box-shadow:2px 2px 6px rgba(0,0,0,.2);}.pw-strength-wrap{margin-top:6px;}.pw-strength-bar{height:4px;background:#dfe4e8;border-radius:2px;overflow:hidden;margin-bottom:4px;}.pw-strength-fill{height:100%;width:0%;transition:width .2s;}.pw-strength-label{font-size:11px;color:#777e84;}