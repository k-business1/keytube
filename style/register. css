*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent;}html,body{width:100%;min-height:100vh;}body.auth-page{display:flex;align-items:center;justify-content:center;padding:20px;font-family:Arial,Helvetica,sans-serif;background:radial-gradient(circle at 12% 15%,rgba(255,255,255,.98),transparent 38%),radial-gradient(circle at 90% 85%,rgba(213,209,255,.65),transparent 42%),#edf1f4;}.auth-wrap{width:100%;display:flex;justify-content:center;align-items:center;}.auth-card{position:relative;width:min(100%,430px);padding:42px 30px 34px;display:flex;flex-direction:column;justify-content:center;border-radius:30px;background:#e9eef2;box-shadow:18px 18px 38px rgba(0,0,0,.14),-18px -18px 38px rgba(255,255,255,.98);isolation:isolate;}.auth-card::before{content:"";position:absolute;inset:-2px;border-radius:32px;background:conic-gradient(from 0deg,transparent 0deg,transparent 245deg,#00e5ff 270deg,#48aaff 292deg,#8855ff 310deg,#00e5ff 330deg,transparent 355deg,transparent 360deg);animation:borderMove 3.2s linear infinite;z-index:-2;}.auth-card::after{content:"";position:absolute;inset:2px;border-radius:28px;background:#e9eef2;z-index:-1;}.border-glow{position:absolute;inset:-9px;border-radius:38px;pointer-events:none;background:conic-gradient(from 0deg,transparent 0deg,transparent 250deg,rgba(0,225,255,.15) 270deg,rgba(0,190,255,.55) 290deg,rgba(135,70,255,.55) 315deg,rgba(0,225,255,.20) 340deg,transparent 355deg);filter:blur(10px);opacity:.7;animation:borderMove 3.2s linear infinite;z-index:-3;}@keyframes borderMove{from{transform:rotate(0deg);}to{transform:rotate(360deg);}}.auth-card.shake{animation:otpShake .5s ease-in-out;}@keyframes otpShake{0%,100%{transform:translateX(0);}12%{transform:translateX(-12px);}24%{transform:translateX(12px);}36%{transform:translateX(-10px);}48%{transform:translateX(10px);}60%{transform:translateX(-7px);}72%{transform:translateX(7px);}84%{transform:translateX(-4px);}92%{transform:translateX(4px);}}.auth-logo{display:flex;align-items:center;justify-content:center;gap:10px;margin-bottom:20px;cursor:pointer;}.logo-kb{width:48px;height:48px;display:flex;align-items:center;justify-content:center;border-radius:50%;background:#e9eef2;box-shadow:6px 6px 12px rgba(0,0,0,.14),-6px -6px 12px rgba(255,255,255,.98);}.logo-kb img{width:24px;height:24px;object-fit:contain;}.logo-brand{font-family:'Bebas Neue',sans-serif;font-size:26px;letter-spacing:1px;color:#24282c;}.auth-title{text-align:center;color:#24282c;font-size:26px;font-weight:700;margin-bottom:6px;}.auth-sub{text-align:center;color:#777e84;font-size:14px;margin-bottom:24px;}.fg{margin-bottom:14px;}.fg label{display:block;font-size:12px;font-weight:700;color:#555a60;margin-bottom:6px;text-transform:uppercase;letter-spacing:.5px;}.hint{font-size:11px;font-weight:400;color:#99a0a6;text-transform:none;}.fi{width:100%;height:48px;border:0;outline:0;border-radius:14px;background:#e9eef2;padding:0 16px;font-size:15px;font-weight:600;color:#292e32;caret-color:#159bc4;box-shadow:inset 5px 5px 10px rgba(0,0,0,.13),inset -5px -5px 10px rgba(255,255,255,.95);}.pw-wrap{position:relative;}.pw-eye{position:absolute;right:14px;top:50%;transform:translateY(-50%);background:none;border:0;cursor:pointer;font-size:16px;opacity:0.6;}.auth-btn{width:100%;height:52px;border:0;outline:0;border-radius:16px;background:#e9eef2;color:#159bc4;font-size:15px;font-weight:700;letter-spacing:.6px;cursor:pointer;margin-top:8px;box-shadow:8px 8px 17px rgba(0,0,0,.14),-8px -8px 17px rgba(255,255,255,.98);transition:.15s ease;}.auth-btn:active{transform:scale(.985);box-shadow:inset 5px 5px 10px rgba(0,0,0,.13),inset -5px -5px 10px rgba(255,255,255,.95);}.aerr{color:#d9534f;font-size:13px;font-weight:600;text-align:center;min-height:18px;margin-bottom:10px;}.auth-divider{text-align:center;position:relative;margin:16px 0;color:#99a0a6;font-size:12px;}.auth-divider span{background:#e9eef2;padding:0 10px;position:relative;z-index:1;}.auth-divider::before{content:"";position:absolute;left:0;top:50%;width:100%;height:1px;background:#d0d7de;z-index:0;}.auth-links{text-align:center;font-size:13px;color:#777e84;margin-top:14px;}.auth-links a{color:#159bc4;text-decoration:none;font-weight:700;margin-left:4px;}.reset-steps{display:flex;align-items:center;justify-content:center;gap:8px;margin-bottom:20px;}.rst{display:flex;align-items:center;gap:6px;opacity:.5;}.rst.active{opacity:1;}.rst-num{width:24px;height:24px;border-radius:50%;background:#e9eef2;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;color:#159bc4;box-shadow:4px 4px 8px rgba(0,0,0,.12),-4px -4px 8px rgba(255,255,255,.98);}.rst-lbl{font-size:11px;font-weight:700;color:#555a60;text-transform:uppercase;}.rst-line{width:20px;height:2px;background:#cbd5d8;}.otp-wrap{display:flex;justify-content:center;align-items:center;gap:8px;margin:20px 0;}.otp-input{width:42px;height:50px;border:0;outline:0;border-radius:12px;background:#e9eef2;text-align:center;font-size:20px;font-weight:700;color:#292e32;box-shadow:inset 4px 4px 8px rgba(0,0,0,.15),inset -4px -4px 8px rgba(255,255,255,.97);}.otp-dash{font-weight:700;color:#99a0a6;margin:0 2px;}.otp-timer-row{text-align:center;font-size:13px;color:#777e84;margin-bottom:14px;}.otp-timer{font-weight:700;color:#159bc4;}.reg-av-upload{position:relative;width:96px;height:96px;border-radius:50%;background:#e9eef2;display:flex;align-items:center;justify-content:center;cursor:pointer;box-shadow:8px 8px 16px rgba(0,0,0,.14),-8px -8px 16px rgba(255,255,255,.98);overflow:hidden;}.reg-av-edit{position:absolute;bottom:0;right:0;background:#159bc4;color:#fff;width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:12px;box-shadow:2px 2px 6px rgba(0,0,0,.2);}.pw-strength-wrap{margin-top:6px;}.pw-strength-bar{height:4px;background:#dfe4e8;border-radius:2px;overflow:hidden;margin-bottom:4px;}.pw-strength-fill{height:100%;width:0%;transition:width .2s;}.pw-strength-label{font-size:11px;color:#777e84;}.ai-shake-btn{position:fixed;bottom:20px;right:20px;width:50px;height:50px;border-radius:50%;background:#e9eef2;display:flex;align-items:center;justify-content:center;box-shadow:6px 6px 14px rgba(0,0,0,.15),-6px -6px 14px rgba(255,255,255,.98);}.ai-shake-btn img{width:24px;height:24px;}